-- Derek hub v2 | Murder Mystery 2
local P=game:GetService("Players")
local RS=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local VIM=game:GetService("VirtualInputManager")
local CG=game:GetService("CoreGui")
local LP=P.LocalPlayer
local CAM=workspace.CurrentCamera
local C={esp=false,espHL=true,auto=false,mode="Pantalla completa",fov=120,range=600,part="Head",autoGun=true,speed=16,jump=50,noclip=false,ij=false}
local COLS={ASESINO=Color3.fromRGB(255,50,50),SHERIFF=Color3.fromRGB(60,150,255),INOCENTE=Color3.fromRGB(90,255,130)}

local function role(p)
	if p==LP then return "YO" end
	local b,c=p:FindFirstChild("Backpack"),p.Character
	local function h(n) return (b and b:FindFirstChild(n)) or (c and c:FindFirstChild(n)) end
	if h("Knife") then return "ASESINO" end
	if h("Gun") then return "SHERIFF" end
	local r=string.lower(tostring(p:GetAttribute("Role") or p:GetAttribute("role") or ""))
	if r:find("murder") or r:find("asesin") then return "ASESINO" end
	if r:find("sheriff") then return "SHERIFF" end
	return "INOCENTE"
end

local tags={}
local function espOn(p)
	if p==LP then return end
	local ch=p.Character or p.CharacterAdded:Wait()
	local head=ch:WaitForChild("Head",5) or ch:WaitForChild("HumanoidRootPart")
	local bb=Instance.new("BillboardGui")
	bb.Name="DerekESP" bb.Size=UDim2.fromOffset(170,40) bb.StudsOffset=Vector3.new(0,2.6,0) bb.MaxDistance=1500 bb.AlwaysOnTop=true
	bb.Adornee=head bb.Parent=head
	local t=Instance.new("TextLabel",bb)
	t.Size=UDim2.fromScale(1,1) t.BackgroundTransparency=1 t.Font=Enum.Font.GothamBlack t.TextSize=16 t.TextStrokeTransparency=0
	local hl=Instance.new("Highlight",ch)
	hl.Name="DerekHL" hl.FillTransparency=.65 hl.OutlineColor=Color3.new(1,1,1) hl.Adornee=ch
	tags[p]={bb=bb,hl=hl,t=t}
end
for _,p in ipairs(P:GetPlayers()) do task.spawn(espOn,p) end
P.PlayerAdded:Connect(function(p) task.spawn(espOn,p) end)

RS.RenderStepped:Connect(function()
	for p,v in pairs(tags) do
		if not p.Parent or not p.Character then v.bb:Destroy() v.hl:Destroy() tags[p]=nil
		else local r=role(p)
			v.t.Text=r v.t.TextColor3=COLS[r] or Color3.new(1,1,1) v.hl.FillColor=COLS[r] or Color3.new(1,1,1)
			v.bb.Enabled=C.esp v.hl.Enabled=C.esp and C.espHL end
	end
end)

local function gun()
	local ch=LP.Character local b=LP:FindFirstChild("Backpack")
	return (ch and ch:FindFirstChild("Gun")) or (b and b:FindFirstChild("Gun"))
end
local function murderer()
	local best,dist
	for _,p in ipairs(P:GetPlayers()) do
		local hr=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if p~=LP and hr and role(p)=="ASESINO" then
			local d=(hr.Position-CAM.CFrame.Position).Magnitude
			if d<=C.range and (not dist or d<dist) then best,dist=p,d end
		end
	end
	return best
end
local lastShot=0

RS.Heartbeat:Connect(function()
	if not C.auto then return end
	local m=murderer() if not m then return end
	local ch=m.Character
	local part=ch:FindFirstChild(C.part) or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("HumanoidRootPart")
	if not part then return end
	local sp,on=CAM:WorldToViewportPoint(part.Position)
	if C.mode=="Pantalla completa" and not (on and sp.Z>0) then return end
	if C.mode=="Fov" then
		local dir=(part.Position-CAM.CFrame.Position).Unit
		if math.deg(math.acos(math.clamp(dir:Dot(CAM.CFrame.LookVector),-1,1)))>C.fov/2 then return end
	end
	local g=gun() if not g then return end
	if g.Parent~=LP.Character then
		if C.autoGun then pcall(function() LP.Character.Humanoid:EquipTool(g) end) end
		return
	end
	CAM.CFrame=CFrame.lookAt(CAM.CFrame.Position,part.Position)
	if os.clock()-lastShot<.12 then return end
	lastShot=os.clock()
	local v=CAM.ViewportSize
	VIM:SendMouseButtonEvent(v.X/2,v.Y/2,0,true,game,1)
	VIM:SendMouseButtonEvent(v.X/2,v.Y/2,0,false,game,1)
end)

RS.Stepped:Connect(function()
	if C.noclip and LP.Character then
		for _,v in ipairs(LP.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide=false end end
	end
end)
UIS.JumpRequest:Connect(function() if C.ij and LP.Character then LP.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping") end end)
LP.CharacterAdded:Connect(function(ch) local h=ch:WaitForChild("Humanoid") h.WalkSpeed=C.speed h.JumpPower=C.jump end)

local function mk(c,pr,par)
	local o=Instance.new(c)
	for k,v in pairs(pr) do o[k]=v end
	o.Parent=par
	return o
end
