local pages,pc={},0
local function page(n)
	local b=mk("TextButton",{Size=UDim2.fromOffset(96,44),Position=UDim2.fromOffset(0,pc*50),BackgroundColor3=Color3.fromRGB(34,34,34),Text=n,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(210,210,210),BorderSizePixel=0},side)
	mk("UICorner",{CornerRadius=UDim.new(0,8)},b) pc=pc+1
	local f=mk("Frame",{Size=UDim2.new(1,-116,1,-58),Position=UDim2.new(0,106,0,50),BackgroundTransparency=1},main)
	pages[n]={b=b,f=f}
	b.MouseButton1Click:Connect(function()
		for _,v in pairs(pages) do v.f.Visible=false v.b.BackgroundColor3=Color3.fromRGB(34,34,34) v.b.TextColor3=Color3.fromRGB(210,210,210) end
		f.Visible=true b.BackgroundColor3=Color3.fromRGB(255,45,45) b.TextColor3=Color3.new(1,1,1)
	end)
	return f
end
local function slider(par,y,lbl,mn,mx,df,cb)
	mk("TextLabel",{Size=UDim2.new(1,-40,0,16),Position=UDim2.fromOffset(0,y),BackgroundTransparency=1,Text=lbl,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(230,230,230),TextXAlignment=Enum.TextXAlignment.Left},par)
	local val=mk("TextLabel",{Size=UDim2.fromOffset(40,16),Position=UDim2.new(1,-40,0,y),BackgroundTransparency=1,Text=tostring(df),Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(255,70,70),TextXAlignment=Enum.TextXAlignment.Right},par)
	local bar=mk("Frame",{Size=UDim2.new(1,-40,0,6),Position=UDim2.fromOffset(0,y+24),BackgroundColor3=Color3.fromRGB(50,50,50),BorderSizePixel=0},par)
	mk("UICorner",{CornerRadius=UDim.new(1,0)},bar)
	local fill=mk("Frame",{Size=UDim2.fromScale(0,1),BackgroundColor3=Color3.fromRGB(255,45,45),BorderSizePixel=0},bar)
	mk("UICorner",{CornerRadius=UDim.new(1,0)},fill)
	local knob=mk("Frame",{Size=UDim2.fromOffset(12,12),AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=Color3.new(1,1,1)},bar)
	mk("UICorner",{CornerRadius=UDim.new(1,0)},knob)
	local on=false
	local function set(x)
		x=math.clamp(x,mn,mx) local a=(x-mn)/(mx-mn)
		fill.Size=UDim2.fromScale(a,1) knob.Position=UDim2.new(a,0,.5,0) val.Text=math.floor(x*10)/10 cb(x)
	end
	bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then on=true set((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X*(mx-mn)+mn) end end)
	UIS.InputChanged:Connect(function(i) if on and i.UserInputType==Enum.UserInputType.MouseMovement then set((i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X*(mx-mn)+mn) end end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then on=false end end)
	set(df) return y+42
end
local function toggle(par,y,lbl,cb)
	local b=mk("TextButton",{Size=UDim2.new(1,-40,0,32),Position=UDim2.fromOffset(0,y),BackgroundColor3=Color3.fromRGB(34,34,34),Text="  "..lbl.."   [OFF]",Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(200,200,200),BorderSizePixel=0,TextXAlignment=Enum.TextXAlignment.Left},par)
	mk("UICorner",{CornerRadius=UDim.new(0,6)},b)
	local on=false
	b.MouseButton1Click:Connect(function()
		on=not on b.Text="  "..lbl.."   ["..(on and "ON" or "OFF").."]"
		b.BackgroundColor3=on and Color3.fromRGB(120,20,20) or Color3.fromRGB(34,34,34) cb(on)
	end)
	return y+40
end
local function button(par,y,lbl,cb)
	local b=mk("TextButton",{Size=UDim2.new(1,-40,0,32),Position=UDim2.fromOffset(0,y),BackgroundColor3=Color3.fromRGB(34,34,34),Text=lbl,Font=Enum.Font.GothamBold,TextSize=12,TextColor3=Color3.fromRGB(255,80,80),BorderSizePixel=0},par)
	mk("UICorner",{CornerRadius=UDim.new(0,6)},b)
	b.MouseButton1Click:Connect(cb)
	return y+40
end

